---
import '../styles/global.css';
import EbookReceitasReader from '../components/app/EbookReceitasReader';
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Guia Prático: 30 Receitas à Prova de Congelamento — Projetos Mautex</title>
    <meta
      name="description"
      content="30 receitas desenvolvidas com um único objetivo: perfeição pós-congelamento. Proteínas suculentas, assados práticos, acompanhamentos e caldos."
    />
  </head>
  <body class="bg-slate-950 font-sans text-slate-100 antialiased min-h-screen p-4 sm:p-8 selection:bg-emerald-500 selection:text-slate-950">
    <div class="max-w-4xl mx-auto">
      <header class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800/80">
        <div class="flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-400">
            Guia Prático Oficial • Acesso Liberado
          </span>
        </div>
        <span className="text-xs font-semibold text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1 rounded-full">
          Produzido por: Projetos Mautex
        </span>
      </header>

      <EbookReceitasReader client:load />

      <footer class="mt-12 pt-8 border-t border-slate-900 text-center text-xs text-slate-500 space-y-2 pb-8">
        <p class="font-bold text-slate-400">
          Guia Prático: 30 Receitas à Prova de Congelamento — Projetos Mautex
        </p>
        <p>
          © {new Date().getFullYear()} Todos os direitos reservados. Reprodução proibida sem autorização.
        </p>
      </footer>
    </div>
  </body>
</html>
