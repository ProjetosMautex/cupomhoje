---
import '../../styles/global.css';
import RaioXCalculator from '../../components/app/RaioXCalculator';
import AppFooter from '../../components/app/AppFooter.astro';

// Proteção de rota
const session = Astro.cookies.get('session');
if (!session) {
  return Astro.redirect('/login');
}
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Raio-X, Blindagem & Gerador de Roteiro de WhatsApp - Fim das Cobranças</title>
  </head>
  <body class="bg-slate-950 font-sans text-slate-100 antialiased min-h-screen p-4 sm:p-8">
    <div class="max-w-4xl mx-auto">
      <a href="/app" class="inline-flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-white mb-6 transition">
        &larr; Voltar ao Início
      </a>

      <header class="mb-8">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Proteção Legal</span>
          <span class="bg-blue-500/20 text-blue-300 text-[10px] font-black uppercase px-2 py-0.5 rounded-full border border-blue-500/40">Lei 14.181</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white mt-1">Raio-X, Blindagem & Gerador de Roteiro de WhatsApp</h1>
        <p class="text-sm text-slate-400 mt-2">
          Descubra o valor real das suas dívidas, calcule seu Mínimo Existencial e gere o roteiro jurídico exato para enviar no WhatsApp dos bancos.
        </p>
      </header>

      <RaioXCalculator client:load />

      <AppFooter />
    </div>
  </body>
</html>
