---
import '../../styles/global.css';
import AppFooter from '../../components/app/AppFooter.astro';

// Proteção de rota
const session = Astro.cookies.get('session');
if (!session) {
  return Astro.redirect('/login');
}
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Painel do Aluno - Protocolo Fim das Cobranças</title>
  </head>
  <body class="bg-slate-950 font-sans text-slate-100 antialiased min-h-screen flex flex-col selection:bg-emerald-500 selection:text-slate-950">
    
    <!-- Cabeçalho Fixo Escuro Mobile-First -->
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-4 sm:px-8">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <span class="text-xs uppercase font-extrabold tracking-widest text-emerald-400">
            Mini-App Oficial
          </span>
          <h1 class="text-lg sm:text-xl font-black text-white leading-tight">
            Protocolo Fim das Cobranças
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 max-w-md">
          Bem-vindo(a) ao seu escudo financeiro. Vamos iniciar a retomada do seu controle.
        </p>
      </div>
    </header>

    <!-- Conteúdo Principal: Dashboard de Blocos -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 py-6 sm:py-10">
      
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Painel de Ferramentas
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Selecione um bloco abaixo para executar o protocolo prático no seu ritmo.
        </p>
      </div>

      <!-- Grid de 4 Blocos Mobile-First -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        
        <!-- Bloco 1: Leitor Interativo com Tooltips -->
        <a
          href="/app/leitura"
          class="group relative bg-slate-900 hover:bg-slate-800/80 border border-slate-800 hover:border-purple-500/60 rounded-3xl p-6 transition-all duration-300 shadow-xl flex flex-col justify-between"
        >
          <div>
            <div className="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              📖
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-purple-400 block mb-1">
              Leitura Guiada
            </span>
            <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
              Leitor Interativo com Tooltips
            </h3>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              O conteúdo completo do e-book em modo leitura limpa com termos difíceis explicados em 1 clique.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs font-bold text-purple-400 uppercase tracking-wider">
            <span>Abrir Leitor</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Bloco 2: Raio-X, Blindagem & Gerador de Roteiro de WhatsApp -->
        <a
          href="/app/raiox"
          class="group relative bg-slate-900 hover:bg-slate-800/80 border border-slate-800 hover:border-blue-500/60 rounded-3xl p-6 transition-all duration-300 shadow-xl flex flex-col justify-between"
        >
          <div>
            <div className="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              🛡️
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-400 block">
                Ferramenta Crucial
              </span>
              <span class="bg-blue-500/20 text-blue-300 text-[10px] font-black uppercase px-2 py-0.5 rounded-full border border-blue-500/40">
                Lei 14.181
              </span>
            </div>
            <h3 class="text-xl font-bold text-white group-hover:text-blue-300 transition-colors mt-1">
              Raio-X, Blindagem & Gerador de Roteiro WhatsApp
            </h3>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              Calcule seu Mínimo Existencial, descubra a gordura de juros e gere o roteiro jurídico exato para enviar no WhatsApp dos bancos.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs font-bold text-blue-400 uppercase tracking-wider">
            <span>Iniciar Raio-X & Roteiro</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Bloco 3: Simulador Bola de Neve -->
        <a
          href="/app/simulador"
          class="group relative bg-slate-900 hover:bg-slate-800/80 border border-slate-800 hover:border-red-500/60 rounded-3xl p-6 transition-all duration-300 shadow-xl flex flex-col justify-between"
        >
          <div>
            <div className="w-12 h-12 rounded-2xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              📈
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-red-400 block mb-1">
              Choque de Realidade
            </span>
            <h3 class="text-xl font-bold text-white group-hover:text-red-300 transition-colors">
              Simulador "Bola de Neve"
            </h3>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              Arraste os sliders e veja como os juros compostos multiplicam a dívida assustadoramente.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs font-bold text-red-400 uppercase tracking-wider">
            <span>Calcular Projeção</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Bloco 4: Missões do Protocolo (Checklist) -->
        <a
          href="/app/missoes"
          class="group relative bg-slate-900 hover:bg-slate-800/80 border border-slate-800 hover:border-emerald-500/60 rounded-3xl p-6 transition-all duration-300 shadow-xl flex flex-col justify-between"
        >
          <div>
            <div className="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              🎯
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 block mb-1">
              Etapa Prática
            </span>
            <h3 class="text-xl font-bold text-white group-hover:text-emerald-300 transition-colors">
              Missões do Protocolo
            </h3>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              Checklist em 3 passos salvando seu avanço para libertar o seu CPF do pesadelo.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs font-bold text-emerald-400 uppercase tracking-wider">
            <span>Abrir Checklist</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

      </div>
    </main>

    <!-- Rodapé Padronizado -->
    <AppFooter />

  </body>
</html>
