---
import '../styles/global.css';
import EbookEmergenciaReader from '../components/app/EbookEmergenciaReader';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>O Plano de Emergência: 15 Marmitas em 15 Minutos — Projetos Mautex</title>
    <meta
      name="description"
      content="O seu material de resgate: 15 receitas expressas feitas em uma panela só em até 15 minutos, prontas para congelar."
    />
    <link
      rel="preload"
      as="image"
      href="/ebook-emergencia/capa-emergencia.webp"
      type="image/webp"
      fetchpriority="high"
    />
  </head>
  <body class="bg-slate-950 font-sans text-slate-100 antialiased min-h-screen p-4 sm:p-8 selection:bg-amber-500 selection:text-slate-950">
    <div class="max-w-4xl mx-auto">
      <header class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800/80">
        <div class="flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-rose-500"></span>
          <span class="text-xs font-extrabold uppercase tracking-widest text-rose-400">
            Plano de Emergência • Acesso Liberado
          </span>
        </div>
        <span class="text-xs font-semibold text-slate-300 bg-slate-900 border border-slate-800 px-3 py-1 rounded-full">
          Produzido por: Projetos Mautex
        </span>
      </header>

      <main>
        <EbookEmergenciaReader client:idle />
      </main>

      <footer class="mt-12 pt-8 border-t border-slate-900 text-center text-xs text-slate-300 space-y-2 pb-8">
        <p class="font-bold text-slate-200">
          O Plano de Emergência: 15 Marmitas em 15 Minutos (Uma Panela Só) — Projetos Mautex
        </p>
        <p>
          © {new Date().getFullYear()} Todos os direitos reservados. Reprodução proibida sem autorização.
        </p>
      </footer>
    </div>
  </body>
</html>
