---
import '../styles/global.css';

// Link de checkout oficial da Eduzz:
const CHECKOUT_EDUZZ_URL = 'https://chk.eduzz.com/b2j5fsfj';
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>O Método do Congelamento Perfeito — Marmitas da Semana em 2 Horas</title>
    <meta
      name="description"
      content="Descubra o Método Exato para Preparar as Marmitas da Sua Semana Inteira em Apenas 2 Horas (Sem Comida Aguada e Sem Desperdício). Acesso Imediato por apenas R$ 14,90."
    />
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2097968984173485');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2097968984173485&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="bg-slate-950 font-sans text-slate-100 antialiased min-h-screen selection:bg-emerald-500 selection:text-slate-950">
    <!-- BARRA DE TOPO URGÊNCIA / MOBILE-FIRST -->
    <div class="bg-amber-500 text-slate-950 py-2 px-4 text-center text-xs sm:text-sm font-extrabold tracking-wide shadow-md">
      ⚡ OFERTA ESPECIAL DE ACESSO IMEDIATO • PAGUE 1 VEZ E ACESSE NO CELULAR
    </div>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-12 pb-20 space-y-12 sm:space-y-16">
      <!-- =============================================================== -->
      <!-- DOBRA 1: HEADLINE (PROMESSA) + PREÇO + BOTÃO IMEDIATO (MOBILE)  -->
      <!-- =============================================================== -->
      <section class="relative rounded-3xl overflow-hidden border border-slate-800 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 p-6 sm:p-10 shadow-2xl">
        <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-8">
          <!-- Coluna de Copy + Botão Imediato -->
          <div class="md:col-span-7 space-y-5 text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-extrabold uppercase tracking-widest">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Método Prático Passo a Passo
            </div>

            <!-- A PROMESSA (HEADLINE EXATA) -->
            <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight tracking-tight">
              Descubra o Método Exato para Preparar as Marmitas da Sua Semana Inteira em{' '}
              <span class="text-emerald-400">
                Apenas 2 Horas
              </span>{' '}
              <span class="text-amber-300 block sm:inline text-xl sm:text-3xl font-extrabold mt-1">
                (Sem Comida Aguada e Sem Desperdício).
              </span>
            </h1>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Pare de jogar comida estragada no lixo ou comer marmita com gosto de geladeira. Domine a técnica simples das 4 Leis de Ouro para congelar e descongelar suas refeições mantendo o sabor e a textura de comida feita na hora.
            </p>

            <!-- O PREÇO + BOTÃO IMEDIATAMENTE ABAIXO DA PROMESSA -->
            <div class="bg-slate-900/95 border-2 border-emerald-500/40 rounded-2xl p-5 space-y-4 shadow-xl">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <span class="text-xs uppercase font-extrabold tracking-wider text-emerald-400 block">
                    Oferta de Lançamento • Liberação na Hora
                  </span>
                  <p class="text-lg sm:text-2xl font-black text-white mt-0.5">
                    Acesso Imediato por apenas{' '}
                    <span class="text-emerald-400 text-2xl sm:text-3xl font-black">R$ 14,90</span>
                  </p>
                </div>
                <span class="text-xs font-bold text-slate-400 line-through">
                  De R$ 47,90
                </span>
              </div>

              <a
                href={CHECKOUT_EDUZZ_URL}
                class="block w-full text-center rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base sm:text-lg py-4 px-6 shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer"
              >
                👉 QUERO ACESSO IMEDIATO POR R$ 14,90
              </a>

              <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-slate-400 pt-1">
                <span>🔒 Compra 100% Segura (Eduzz)</span>
                <span>•</span>
                <span>⚡ Pix ou Cartão</span>
                <span>•</span>
                <span>📱 Acesso no Celular e PC</span>
              </div>
            </div>
          </div>

          <!-- Mockup 3D Visual da Capa -->
          <div class="md:col-span-5 flex flex-col items-center justify-center">
            <div class="relative w-60 sm:w-72 rounded-2xl overflow-hidden shadow-2xl border-2 border-emerald-500/40 group">
              <img
                src="/ebook-congelamento/capa.jpg"
                alt="Mockup 3D do Ebook O Método do Congelamento Perfeito"
                class="w-full h-auto object-cover group-hover:scale-105 transition duration-500"
              />
              <div class="bg-slate-950/95 border-t border-slate-800 px-4 py-2.5 text-center">
                <span class="text-xs font-extrabold text-amber-400 uppercase tracking-wider">
                  📖 Guia Digital Interativo + Checklists
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =============================================================== -->
      <!-- DOBRA 2: A DOR VS. SOLUÇÃO (OS 2 BENEFÍCIOS MÁXIMOS)            -->
      <!-- =============================================================== -->
      <section class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs uppercase font-extrabold tracking-widest text-amber-400">
            Por que este método muda sua rotina?
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
            Dois Problemas Que Acabam Hoje na Sua Cozinha
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Benefício 1: Economia de Dinheiro -->
          <div class="bg-slate-900/80 border border-emerald-500/30 rounded-3xl p-6 sm:p-8 space-y-4 shadow-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-extrabold uppercase tracking-wider">
              💰 Benefício #1 • Economia Real no Bolso
            </div>

            <h3 class="text-xl sm:text-2xl font-black text-white leading-snug">
              Se Paga no Primeiro Alimento Que Não Vai Para o Lixo
            </h3>

            <div class="bg-rose-950/30 border-l-4 border-rose-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-300 space-y-1">
              <strong class="text-rose-300 block">❌ Como é hoje:</strong>
              Você faz compras no mercado, deixa legumes murchando na gaveta da geladeira, esquece sobras de carne ou feijão que azedam e acaba jogando dinheiro literalmente no lixo toda semana.
            </div>

            <div class="bg-emerald-950/30 border-l-4 border-emerald-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-200 space-y-1">
              <strong class="text-emerald-300 block">✅ Com o Método:</strong>
              O valor simbólico de <strong>R$ 14,90</strong> se paga logo no primeiro tomate, bandeja de frango ou porção de carne que você congela do jeito certo e salva de estragar — sem falar no primeiro pedido caro de aplicativo que você evita na semana!
            </div>
          </div>

          <!-- Benefício 2: Economia de Tempo -->
          <div class="bg-slate-900/80 border border-amber-500/30 rounded-3xl p-6 sm:p-8 space-y-4 shadow-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-extrabold uppercase tracking-wider">
              ⏰ Benefício #2 • Paz nas Noites da Semana
            </div>

            <h3 class="text-xl sm:text-2xl font-black text-white leading-snug">
              Nunca Mais Lave Panelas em Uma Quarta-Feira à Noite
            </h3>

            <div class="bg-rose-950/30 border-l-4 border-rose-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-300 space-y-1">
              <strong class="text-rose-300 block">❌ Como é hoje:</strong>
              Chegar exausto do trabalho às 20h, encarar a pia cheia, ter que picar alho e cebola, esperar a panela de pressão e ainda limpar o fogão engordurado todas as noites.
            </div>

            <div class="bg-emerald-950/30 border-l-4 border-emerald-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-200 space-y-1">
              <strong class="text-emerald-300 block">✅ Com o Método:</strong>
              Com o <strong>Cronograma de Linha de Montagem de 2 Horas</strong>, você usa forno, pressão e bocas do fogão ao mesmo tempo em um único dia. De segunda a sexta, sua única tarefa é tirar a marmita pronta e aquecer em 3 minutos com sabor de comida fresca!
            </div>
          </div>
        </div>
      </section>

      <!-- =============================================================== -->
      <!-- DOBRA 3: O QUE TEM DENTRO (VISUAL + MOCKUPS PRÁTICOS)           -->
      <!-- =============================================================== -->
      <section class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-10 space-y-8 shadow-2xl">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs uppercase font-extrabold tracking-widest text-sky-400">
            Por Dentro do Material • Direto ao Ponto
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
            Veja Tudo o Que Você Vai Receber Imediatamente
          </h2>
          <p class="text-slate-300 text-sm sm:text-base">
            Sem enrolação teórica. Um guia visual, interativo e pensado para você abrir no celular enquanto está na cozinha:
          </p>
        </div>

        <!-- Galeria Visual de Mockups do Conteúdo Interno -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Módulo 1 -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/lei-2-bloqueio-ar.jpg"
              alt="As 4 Leis de Ouro do Congelamento"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-amber-400">
                Capítulo 1 • A Base Científica Simples
              </span>
              <h3 class="text-lg font-black text-white">
                As 4 Leis de Ouro Anti-Água
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                O passo a passo de resfriamento, bloqueio de ar (regra de 1 dedo de espaço), porcionamento seguro e etiquetagem para nenhuma marmita criar cristais de gelo.
              </p>
            </div>
          </div>

          <!-- Módulo 2 -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/cap2-branqueamento.jpg"
              alt="Tabela do Semáforo dos Alimentos"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-400">
                Capítulo 2 • O Semáforo dos Ingredientes
              </span>
              <h3 class="text-lg font-black text-white">
                O Que Congelar e O Que Nunca Colocar no Freezer
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Descubra por que a batata inglesa fica esponjosa (e quais raízes usar no lugar), como fazer o choque térmico em brócolis e o segredo dos molhos que nunca talham.
              </p>
            </div>
          </div>

          <!-- Módulo 3 -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/cap3-etapa4-montagem.jpg"
              alt="Cronograma de Cozinha em Lote em 2 Horas"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-sky-400">
                Capítulo 3 • Linha de Produção
              </span>
              <h3 class="text-lg font-black text-white">
                O Cronograma Exato de 2 Horas
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                O roteiro cronometrado minuto a minuto (do minuto 0 ao 120) para cozinhar todas as marmitas da semana sujando a tábua uma única vez.
              </p>
            </div>
          </div>

          <!-- Módulo 4 -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/cap4-microondas-vapor.jpg"
              alt="A Arte da Ressurreição no Micro-ondas"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-purple-400">
                Capítulo 4 + Checklist de Primeira Semana
              </span>
              <h3 class="text-lg font-black text-white">
                O Truque do Reaquecimento a Vapor
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                A técnica da colher de água e tampa entreaberta no micro-ondas para que o arroz e o frango saiam úmidos e macios como se tivessem acabado de sair da panela.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- =============================================================== -->
      <!-- DOBRA 4: CHAMADA FINAL DE CONVERSÃO                             -->
      <!-- =============================================================== -->
      <section
        id="comprar-eduzz"
        class="bg-gradient-to-br from-emerald-950/70 via-slate-900 to-slate-950 border-2 border-emerald-500/50 rounded-3xl p-6 sm:p-10 shadow-2xl text-center space-y-6"
      >
        <h2 class="text-2xl sm:text-4xl font-black text-white max-w-2xl mx-auto leading-tight">
          Comece Sua Semana Com o Freezer Cheio e a Pia Limpa
        </h2>

        <p class="text-slate-200 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
          Toque no botão abaixo para garantir seu acesso imediato ao <strong>Método do Congelamento Perfeito</strong> por menos do que custa uma única taxa de entrega de aplicativo.
        </p>

        <div class="bg-slate-950/90 border border-slate-800 rounded-2xl p-6 max-w-md mx-auto space-y-4 shadow-xl">
          <div class="text-xs font-bold uppercase tracking-widest text-slate-400">
            Pagamento Único • Sem Mensalidades
          </div>
          <div class="text-4xl sm:text-5xl font-black text-emerald-400">
            R$ 14,90
          </div>
          <div class="text-xs text-slate-300">
            Acesso liberado imediatamente após a confirmação
          </div>

          <a
            href={CHECKOUT_EDUZZ_URL}
            class="block w-full text-center rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base sm:text-lg py-4 px-6 shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer"
          >
            🛒 COMPRAR AGORA POR R$ 14,90
          </a>
        </div>
      </section>
    </main>

    <footer class="border-t border-slate-900 py-8 px-4 text-center text-xs text-slate-500 space-y-2">
      <p class="font-bold text-slate-400">
        O Método do Congelamento Perfeito — Projetos Mautex
      </p>
      <p>
        © {new Date().getFullYear()} Todos os direitos reservados.
      </p>
    </footer>
  </body>
</html>
