---
import '../styles/global.css';

// Link de checkout oficial da Eduzz:
const CHECKOUT_EDUZZ_URL = 'https://chk.eduzz.com/b2j5fsfj';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>O Método do Congelamento Perfeito — Fim da Comida Aguada no Freezer</title>
    <meta
      name="description"
      content="Descubra o Método Exato Para Congelar e Aquecer Suas Marmitas Sem Deixar a Comida Aguada ou com Gosto de Geladeira. Acesso Imediato por apenas R$ 14,90."
    />
    <!-- Preload da imagem principal (LCP) em formato WebP ultraleve -->
    <link
      rel="preload"
      as="image"
      href="/ebook-congelamento/capa-sales.webp"
      type="image/webp"
      fetchpriority="high"
    />
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2097968984173485');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=2097968984173485&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="bg-slate-950 font-sans text-slate-100 antialiased min-h-screen selection:bg-emerald-500 selection:text-slate-950">
    <!-- BARRA DE TOPO URGÊNCIA / MOBILE-FIRST -->
    <div class="bg-amber-500 text-slate-950 py-2 px-4 text-center text-xs sm:text-sm font-extrabold tracking-wide shadow-md">
      ⚡ OFERTA ESPECIAL DE ACESSO IMEDIATO • PAGUE 1 VEZ E ACESSE NO CELULAR
    </div>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-12 pb-20 space-y-12 sm:space-y-16">
      <!-- =============================================================== -->
      <!-- DOBRA 1: HEADLINE (PROMESSA) + PREÇO + BOTÃO IMEDIATO (MOBILE)  -->
      <!-- =============================================================== -->
      <section class="relative rounded-3xl overflow-hidden border border-slate-800 bg-slate-900/90 p-6 sm:p-10 shadow-2xl">
        <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-8">
          <!-- Coluna de Copy + Botão Imediato -->
          <div class="md:col-span-7 space-y-5 text-left">
            <!-- PRÉ-HEADLINE -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-extrabold tracking-wide">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Para você que já cozinha para a semana toda...
            </div>

            <!-- HEADLINE PRINCIPAL -->
            <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight tracking-tight">
              Descubra o Método Exato Para Congelar e Aquecer Suas Marmitas{' '}
              <span class="text-emerald-400">
                Sem Deixar a Comida Aguada
              </span>{' '}
              <span class="text-amber-300">
                ou com "Gosto de Geladeira".
              </span>
            </h1>

            <!-- SUB-HEADLINE -->
            <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
              O congelamento não é um truque mágico, é conservação térmica. Aprenda a técnica que mantém o <strong>arroz soltinho</strong>, a <strong>carne suculenta</strong> e os <strong>legumes crocantes</strong>, preservando 100% da textura de comida feita na hora.
            </p>

            <!-- O PREÇO + BOTÃO IMEDIATAMENTE ABAIXO DA PROMESSA -->
            <div class="bg-slate-950 border-2 border-emerald-500/40 rounded-2xl p-5 space-y-4 shadow-xl">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <span class="text-xs uppercase font-extrabold tracking-wider text-emerald-400 block">
                    Oferta de Lançamento • Liberação na Hora
                  </span>
                  <p class="text-lg sm:text-2xl font-black text-white mt-0.5">
                    Acesso Imediato por apenas{' '}
                    <span class="text-emerald-400 text-2xl sm:text-3xl font-black">R$ 14,90</span>
                  </p>
                </div>
                <span class="text-xs font-bold text-slate-300 line-through">
                  De R$ 47,90
                </span>
              </div>

              <a
                href={CHECKOUT_EDUZZ_URL}
                class="block w-full text-center rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base sm:text-lg py-4 px-6 shadow-lg transition cursor-pointer"
              >
                👉 QUERO ACESSO IMEDIATO POR R$ 14,90
              </a>

              <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-slate-300 pt-1">
                <span>🔒 Compra 100% Segura (Eduzz)</span>
                <span>•</span>
                <span>⚡ Pix ou Cartão</span>
                <span>•</span>
                <span>📱 Acesso no Celular e PC</span>
              </div>
            </div>
          </div>

          <!-- Mockup 3D Visual da Capa (WebP Otimizado 46 KiB) -->
          <div class="md:col-span-5 flex flex-col items-center justify-center">
            <div class="relative w-60 sm:w-72 rounded-2xl overflow-hidden shadow-2xl border-2 border-emerald-500/40">
              <img
                src="/ebook-congelamento/capa-sales.webp"
                alt="Mockup 3D do Ebook O Método do Congelamento Perfeito"
                width="480"
                height="643"
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto object-cover"
              />
              <div class="bg-slate-950 border-t border-slate-800 px-4 py-2.5 text-center">
                <span class="text-xs font-extrabold text-amber-300 uppercase tracking-wider">
                  📖 Guia Digital Interativo + Checklists
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =============================================================== -->
      <!-- DOBRA 2: AS DUAS MAIORES FRUSTRAÇÕES (TEXTURA + TEMPO)          -->
      <!-- =============================================================== -->
      <section class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs uppercase font-extrabold tracking-widest text-amber-400">
            Por que este método vai salvar o seu domingo?
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
            As Duas Maiores Frustrações Que Acabam Hoje na Sua Cozinha
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Benefício 1: Textura e Sabor -->
          <div class="bg-slate-900/90 border border-emerald-500/30 rounded-3xl p-6 sm:p-8 space-y-4 shadow-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-extrabold uppercase tracking-wider">
              🧊 Benefício #1 • O Fim da Comida Empapada e Ressecada
            </div>

            <h3 class="text-xl sm:text-2xl font-black text-white leading-snug">
              O seu esforço não vai mais para o lixo na quarta-feira.
            </h3>

            <div class="bg-rose-950/30 border-l-4 border-rose-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-200 space-y-1">
              <strong class="text-rose-300 block">❌ Como é hoje:</strong>
              Você passa horas no fogão no fim de semana preparando tudo com carinho. Mas quando você aquece a marmita no meio da semana, o arroz está nadando em uma poça de água, a batata está esponjosa e a carne está cinza e seca. Todo o seu esforço perde o sabor.
            </div>

            <div class="bg-emerald-950/30 border-l-4 border-emerald-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-100 space-y-1">
              <strong class="text-emerald-300 block">✅ Com o Método:</strong>
              Você vai aplicar as <strong>4 Leis do Congelamento Perfeito</strong> (Choque Térmico e Bloqueio de Ar). Ao retirar sua marmita do micro-ondas, o molho estará brilhando, os grãos soltinhos e a carne com a mesma suculência exata de quando saiu da panela.
            </div>
          </div>

          <!-- Benefício 2: Linha de Produção Inteligente -->
          <div class="bg-slate-900/90 border border-amber-500/30 rounded-3xl p-6 sm:p-8 space-y-4 shadow-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-extrabold uppercase tracking-wider">
              ⏰ Benefício #2 • A Linha de Produção Inteligente
            </div>

            <h3 class="text-xl sm:text-2xl font-black text-white leading-snug">
              Nunca mais perca o domingo inteiro na beira do fogão.
            </h3>

            <div class="bg-rose-950/30 border-l-4 border-rose-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-200 space-y-1">
              <strong class="text-rose-300 block">❌ Como é hoje:</strong>
              Mesmo já fazendo marmitas, o processo é exaustivo. Você faz um prato de cada vez, suja todas as panelas da casa e termina o seu domingo de folga exausta e com uma montanha de louça na pia.
            </div>

            <div class="bg-emerald-950/30 border-l-4 border-emerald-500 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-100 space-y-1">
              <strong class="text-emerald-300 block">✅ Com o Método:</strong>
              Com o <strong>Cronograma de Linha de Montagem de 120 Minutos</strong>, você aprende a sincronizar forno, panela de pressão e fogão ao mesmo tempo. Em apenas 2 horas, sua semana inteira está empilhada no freezer e a sua cozinha já está limpa!
            </div>
          </div>
        </div>
      </section>

      <!-- =============================================================== -->
      <!-- DOBRA 3: O QUE TEM DENTRO (IMAGENS WEBP LAZY-LOAD ULTRALEVES)   -->
      <!-- =============================================================== -->
      <section class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-10 space-y-8 shadow-2xl">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs uppercase font-extrabold tracking-widest text-sky-400">
            Por Dentro do Material • Direto ao Ponto
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
            O Segredo dos Restaurantes, Agora no Seu Celular
          </h2>
          <p class="text-slate-200 text-sm sm:text-base">
            Sem enrolação teórica. Um guia visual e interativo para você abrir enquanto cozinha:
          </p>
        </div>

        <!-- Galeria Visual de Mockups do Conteúdo Interno -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Módulo 1 -->
          <div class="bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/lei-2-sales.webp"
              alt="As 4 Leis Anti-Água e Queimadura de Frio"
              width="600"
              height="322"
              loading="lazy"
              decoding="async"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-amber-400">
                Capítulo 1 • A Base Científica Simples
              </span>
              <h3 class="text-lg font-black text-white">
                As 4 Leis Anti-Água e Queimadura de Frio
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
                O passo a passo vital de resfriamento, bloqueio de oxigênio (a regra de 1 dedo de espaço) e etiquetagem para impedir que a sua comida crie aqueles cristais de gelo que destroem o sabor.
              </p>
            </div>
          </div>

          <!-- Módulo 2 -->
          <div class="bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/cap2-sales.webp"
              alt="O Semáforo dos Ingredientes: Por Que Sua Batata Fica Esponjosa?"
              width="600"
              height="322"
              loading="lazy"
              decoding="async"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-400">
                Capítulo 2 • O Semáforo dos Ingredientes
              </span>
              <h3 class="text-lg font-black text-white">
                Por Que Sua Batata Fica Esponjosa?
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
                O mapa absoluto do que reage bem ao frio. Descubra quais raízes usar para o purê perfeito, como fazer o branqueamento em brócolis para manter o verde vivo e o segredo dos molhos que nunca talham.
              </p>
            </div>
          </div>

          <!-- Módulo 3 -->
          <div class="bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/cap3-sales.webp"
              alt="A Linha de Produção: O Cronograma Exato de 2 Horas"
              width="600"
              height="322"
              loading="lazy"
              decoding="async"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-sky-400">
                Capítulo 3 • A Linha de Produção
              </span>
              <h3 class="text-lg font-black text-white">
                O Cronograma Exato de 2 Horas
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
                O roteiro cronometrado minuto a minuto (do minuto 0 ao 120) para você parar de cozinhar prato por prato e produzir todas as marmitas sujando a tábua de corte uma única vez.
              </p>
            </div>
          </div>

          <!-- Módulo 4 -->
          <div class="bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col">
            <img
              src="/ebook-congelamento/cap4-sales.webp"
              alt="O Truque do Micro-ondas (Estufa de Vapor)"
              width="600"
              height="322"
              loading="lazy"
              decoding="async"
              class="w-full h-44 object-cover object-center"
            />
            <div class="p-5 space-y-2 flex-1">
              <span class="text-xs font-extrabold uppercase tracking-wider text-purple-400">
                Capítulo 4 + Checklist de Execução
              </span>
              <h3 class="text-lg font-black text-white">
                O Truque do Micro-ondas (Estufa de Vapor)
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
                O aquecimento errado destrói um prato perfeito. Aprenda a técnica da colher de água e tampa entreaberta para reidratar os grãos e garantir que a refeição saia fumegante e macia.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- =============================================================== -->
      <!-- DOBRA 4: CHAMADA FINAL DE CONVERSÃO                             -->
      <!-- =============================================================== -->
      <section
        id="comprar-eduzz"
        class="bg-slate-900 border-2 border-emerald-500/50 rounded-3xl p-6 sm:p-10 shadow-2xl text-center space-y-6"
      >
        <h2 class="text-2xl sm:text-4xl font-black text-white max-w-2xl mx-auto leading-tight">
          Não deixe o seu esforço na cozinha perder o sabor.
        </h2>

        <p class="text-slate-200 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
          Toque no botão abaixo para garantir o método de conservação térmica definitivo por menos do que custa um lanche na padaria. <span class="text-amber-300 font-semibold">(Com os complementos de Receitas Práticas disponíveis no checkout).</span>
        </p>

        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 max-w-md mx-auto space-y-4 shadow-xl">
          <div class="text-xs font-bold uppercase tracking-widest text-slate-300">
            Pagamento Único • Sem Mensalidades
          </div>
          <div class="text-4xl sm:text-5xl font-black text-emerald-400">
            R$ 14,90
          </div>
          <div class="text-xs text-slate-200">
            Acesso liberado imediatamente após a confirmação
          </div>

          <a
            href={CHECKOUT_EDUZZ_URL}
            class="block w-full text-center rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base sm:text-lg py-4 px-6 shadow-lg transition cursor-pointer"
          >
            🛒 COMPRAR AGORA POR R$ 14,90
          </a>
        </div>
      </section>
    </main>

    <footer class="border-t border-slate-900 py-8 px-4 text-center text-xs text-slate-300 space-y-2">
      <p class="font-bold text-slate-200">
        O Método do Congelamento Perfeito — Projetos Mautex
      </p>
      <p>
        © {new Date().getFullYear()} Todos os direitos reservados.
      </p>
    </footer>
  </body>
</html>
