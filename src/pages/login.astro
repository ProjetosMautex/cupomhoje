---
import '../styles/global.css';
import { isValidSession, APP_EMAIL } from '../lib/auth-config';

// Se já tiver logado com a senha válida da semana, vai pro app
const session = Astro.cookies.get('session');
if (isValidSession(session?.value)) {
  return Astro.redirect('/app');
}

const error = Astro.url.searchParams.get('error');
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesso do Aluno - Protocolo Fim das Cobranças</title>
  </head>
  <body class="bg-slate-950 font-sans text-white min-h-screen flex items-center justify-center p-4">
    
    <div class="bg-slate-900 p-8 rounded-3xl border border-slate-800 shadow-2xl w-full max-w-md relative">
      <div class="text-center mb-8">
        <div class="w-14 h-14 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-3 shadow-inner">
          🛡️
        </div>
        <h1 class="text-2xl font-black text-white">Área de Membros</h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">App Oficial • Protocolo Fim das Cobranças</p>
      </div>

      <!-- Alertas de Status -->
      {error === 'wrong_password' && (
        <div class="mb-6 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs sm:text-sm leading-relaxed space-y-2">
          <p class="font-bold flex items-center gap-1.5 text-amber-400">
            <span>⚠️</span> Senha incorreta ou desatualizada!
          </p>
          <p class="text-slate-300">
            A senha deste aplicativo é atualizada toda semana (aos domingos). Se você já é aluno, acesse a sua Área de Membros na Kiwify para conferir a senha atual.
          </p>
        </div>
      )}

      {error === 'empty' && (
        <div class="mb-6 p-4 rounded-2xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs sm:text-sm">
          ⚠️ Preencha a senha para acessar.
        </div>
      )}
      
      <form action="/api/auth/login" method="POST" class="space-y-5">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
            E-mail de Acesso
          </label>
          <input 
            type="email" 
            name="email" 
            required 
            value={APP_EMAIL}
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-sm" 
          />
          <span class="text-[11px] text-slate-500 mt-1 block">
            Utilize o e-mail padrão acima ou o seu e-mail de compra.
          </span>
        </div>
        
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
            Senha Semanal da Kiwify
          </label>
          <input 
            type="password" 
            name="password" 
            required 
            placeholder="Digite a senha desta semana..." 
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-sm" 
          />
        </div>

        <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800 text-[11px] text-slate-400 leading-relaxed flex items-start gap-2">
          <span class="text-base shrink-0">💡</span>
          <span>
            <strong>Onde encontro a senha?</strong> Ela está liberada no <strong>Módulo 1</strong> dentro da sua Área de Membros da Kiwify e é renovada todo domingo.
          </span>
        </div>
        
        <button 
          type="submit" 
          class="w-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black py-4 px-4 rounded-xl transition shadow-[0_0_20px_rgba(16,185,129,0.3)] text-sm uppercase tracking-wide cursor-pointer"
        >
          Entrar no App Oficial
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-slate-800 text-center space-y-3">
        <a 
          href="https://dashboard.kiwify.com.br" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-xs text-emerald-400 hover:underline font-bold block"
        >
          Abrir Área de Membros Kiwify &rarr;
        </a>
        <p class="text-[11px] text-slate-500">
          Ainda não tem acesso? <a href="/fim-das-cobrancas" class="text-slate-300 hover:underline">Ver Oferta Oficial</a>
        </p>
      </div>
    </div>

  </body>
</html>
