  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Cupom Hoje - Página Inicial</title>
  </head>
  <body class="bg-slate-100 min-h-screen flex items-center justify-center font-sans">
    <div class="text-center p-8 max-w-lg bg-white rounded-2xl shadow-lg">
      <h1 class="text-4xl font-bold text-slate-800 mb-4">Cupom Hoje</h1>
